package addons

// TEMPLATE: a menu option.
//
// To use it:
//  1. Copy this file to your addons directory as opt_<name>.go.
//  2. Change the import path of the dashboard package to your own.
//  3. Pick a Number that no other option uses (a clash is a startup error that
//     names both files) and the ID of a section declared in your dashboard file.
//
// Nothing else is edited: the file registers itself from init().

import (
	"example.com/yourapp/dashboard"
)

func init() {
	dashboard.Registry.Add(dashboard.Option{
		Key:     "my_feature", // unique and stable; also the prefix for any Store keys
		Section: "settings",   // a section declared in the dashboard file
		Number:  42,           // typed on the keyboard to jump here; unique across the dashboard
		Hotkey:  "y",          // optional: runs this option from any page; shown as "(y)"
		Label:   "My Feature",
		// Badge is the row's current state, shown after the label. Optional.
		Badge: func(c *dashboard.Ctx) string { return c.OnOff(true) },
		// What Enter (or Space) does: set exactly one of
		//   Do:    func(c) { ... }                  an action, with nothing to return
		//   Opens: "view_id"                        open a registered view
		//   Modal: func(c) Modal { return ... }     open a pop-up
		//   Run:   func(c) tea.Cmd { ... }          when you must return a command
		Do: func(c *dashboard.Ctx) { c.Flash("My feature ran") },
	})
}
