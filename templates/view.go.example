package addons

// TEMPLATE: a full-screen view.
//
// To use it:
//  1. Copy this file to your addons directory as <name>_view.go, or run
//     dashygotui new view <name>.
//  2. Change the import path of the dashboard package to your own.
//  3. Place it in addons.go, in the Items of a panel: myFeatureView
//     The row opens it. A view with no row of its own goes in Map.Views
//     instead, and is opened by its ID.
//
// A view draws its Body. Follow makes it a log, Scroll scrolls it, Framed puts it
// in a panel. The Back key (Esc or b) returns. For a full page of panels opened
// from a row, use a sub-page instead (dashygotui new page <name>).

import (
	"fmt"

	"example.com/yourapp/dashboard"
	"github.com/CeeSmag/dashygotui"
)

var myFeatureView = dashboard.View{
	ID: "my_feature", Title: "My Feature", Scroll: true, Framed: true,
	// Entry is how the row that opens the view looks. Optional.
	Entry: &dashboard.Entry{Note: "full screen"},
	Body: func(c *dashboard.Ctx, _ dashygotui.Size) []string {
		var rows []string
		for i := 1; i <= 50; i++ {
			rows = append(rows, fmt.Sprintf("line %d of My Feature", i))
		}
		return rows
	},
}
