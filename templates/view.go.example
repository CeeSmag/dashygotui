package addons

// TEMPLATE: a full-screen view and the option that opens it.
//
// To use it:
//  1. Copy this file to your addons directory as view_<name>.go.
//  2. Change the import path of the dashboard package to your own.
//  3. Pick an unused option Number and a section declared in your dashboard file.
//
// The view and the option that opens it are one declaration: Entry registers
// the option (and, with HotkeyHint, advertises its hotkey in the footer). A view
// draws a status panel above a menu, or set Body to draw everything yourself.
// Body with Follow is a log; with Framed it is a panel. The Back key (Esc or b)
// returns to the page. Your dashboard package needs the alias
// `type Entry = dashygotui.Entry[State]` next to its other aliases.

import (
	"example.com/yourapp/dashboard"
	"github.com/CeeSmag/dashygotui"
	"github.com/CeeSmag/dashygotui/panel"
)

func init() {
	dashboard.Registry.Add(dashboard.View{
		ID: "my_view", Title: "My View", Subtitle: "details",
		Entry: &dashboard.Entry{Section: "actions", Number: 43}, // Label defaults to Title; Mode to TITLE
		Status: func(c *dashboard.Ctx, _ dashygotui.Size) []string {
			return []string{panel.Row(c.Theme(), "Hello", "from my view")}
		},
		// Items is a fixed menu, numbered by position. Each row says what it does:
		// Do (an action), Opens (another view), Modal (a pop-up) or Run (a command).
		Items: []dashboard.Option{
			{Label: "Do Something", Note: "a muted note", Do: func(c *dashboard.Ctx) { c.Flash("Did something") }},
		},
	})
}
