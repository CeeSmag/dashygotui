package addons

// TEMPLATE: a row that opens a custom pop-up.
//
// For most needs the modal package already has what you want: Edit, Confirm,
// Typed, Notice, Choice and Slider. Write your own only for something else.
//
// To use it:
//  1. Copy this file to your addons directory as <name>_modal.go, or run
//     dashygotui new modal <name>.
//  2. Change the import path of the dashboard package to your own.
//  3. Place it in addons.go, in the Items of a panel: myFeatureModalOpt
//
// All state lives in the modal value, never in package variables.

import (
	tea "charm.land/bubbletea/v2"

	"example.com/yourapp/dashboard"
	"github.com/CeeSmag/dashygotui"
	"github.com/CeeSmag/dashygotui/panel"
)

// myFeatureModal counts presses of the space bar until Enter.
type myFeatureModal struct{ presses int }

// HandleKey implements dashygotui.Modal.
func (m *myFeatureModal) HandleKey(c *dashboard.Ctx, msg tea.KeyPressMsg) tea.Cmd {
	switch msg.String() {
	case "space":
		m.presses++
	case "enter", "esc":
		c.CloseModal()
		c.Flash("Counted presses")
	}
	return nil
}

// Render implements dashygotui.Modal. Return the box only; the dashboard
// centres it and clips it to the terminal.
func (m *myFeatureModal) Render(c *dashboard.Ctx, size dashygotui.Size) []string {
	body := []string{"Press space, then Enter.", "", panel.Row(c.Theme(), "Count", string(rune('0'+m.presses%10)))}
	return panel.Panel(c.Theme(), "My Feature", "", "", min(50, size.Cols), len(body)+2, body)
}

var myFeatureModalOpt = dashboard.Option{
	Label: "My Feature",
	// Modal returns the pop-up to open.
	Modal: func(*dashboard.Ctx) dashboard.Modal { return &myFeatureModal{} },
}
