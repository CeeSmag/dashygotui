package addons

// TEMPLATE: a widget, a read-only panel.
//
// To use it:
//  1. Copy this file to your addons directory as <name>_widget.go, or run
//     dashygotui new widget <name>.
//  2. Change the import path of the dashboard package to your own.
//  3. Place it in addons.go, as a panel of a page: {Widget: myFeatureWidget}
//
// This file says only what it shows.

import (
	"fmt"
	"time"

	tea "charm.land/bubbletea/v2"

	"example.com/yourapp/dashboard"
	"github.com/CeeSmag/dashygotui"
	"github.com/CeeSmag/dashygotui/panel"
)

// myFeatureTicks is the widget's own state: a counter that belongs to this
// dashboard (dashygotui.Local), not a package-level variable, which every
// dashboard in the process would share.
func myFeatureTicks(c *dashboard.Ctx) *int { return dashygotui.Local[int](c, "my_feature.ticks") }

var myFeatureWidget = dashboard.Widget{
	Title:     "My Feature",
	Subtitle:  "live readout",
	MinHeight: 6, // rows, borders included, wanted when panels are stacked

	// Badge is shown in the top border. Optional.
	Badge: func(c *dashboard.Ctx) string { return c.Theme().Green.Render(c.Theme().G.Bullet + " LIVE") },

	// Tick runs on every refresh tick, for a widget that samples over time.
	// Optional.
	Tick: func(c *dashboard.Ctx, _ time.Time) tea.Cmd {
		*myFeatureTicks(c)++
		return nil
	},

	// Render returns the body rows for the inner size. It runs on every
	// frame, so keep it cheap and read data from c.State().
	Render: func(c *dashboard.Ctx, size dashygotui.Size) []string {
		th := c.Theme()
		return []string{
			panel.Row(th, "Size", fmt.Sprintf("%dx%d", size.Cols, size.Rows)),
			panel.Row(th, "Ticks", fmt.Sprint(*myFeatureTicks(c))),
		}
	},
}
