package addons

// TEMPLATE: what a tab does apart from its panels.
//
// A tab is written in the map: its title, layout and panels. Some tabs also
// need behaviour: a badge on the tab, a compact version for small terminals, a
// session that runs while the tab is on screen. That goes here, in
// <name>_page.go, and the map refers to it:
//
//	{Title: "My Feature", Badge: myFeatureTabBadge, Session: myFeatureTabSession, Panels: ...}
//
// For a window opened from a row, use a subpage instead (dashygotui new subpage
// <name>). To use this file, run dashygotui new page <name>, or copy it as
// <name>_page.go and change the import path of the dashboard package.

import (
	"example.com/yourapp/dashboard"
)

func myFeatureTabBadge(c *dashboard.Ctx) string {
	return c.Theme().Muted.Render("live")
}

// myFeatureTabSession starts work that only matters while the tab is on
// screen, and returns what stops it.
func myFeatureTabSession(*dashboard.Ctx) func() {
	return func() {}
}
