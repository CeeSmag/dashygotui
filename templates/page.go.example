package addons

// TEMPLATE: what a sub-page does: a page placed as a row of a panel, opened
// full-screen with panels of its own, numbered from 1, and Back to return.
//
// To use it:
//  1. Copy this file to your addons directory as <name>_page.go, or run
//     dashygotui new page <name>.
//  2. Change the import path of the dashboard package to your own.
//  3. Place the sub-page in addons.go, in the Items of a panel. Its panels are
//     placement, so they are written in the map, like any page's:
//
//	dashboard.Page{Title: "My Feature", Badge: myFeatureBadge, Session: myFeatureSession,
//		Panels: []dashboard.Panel{{Title: "Tools", Items: []dashboard.Addon{someOpt}}}}
//
// This file holds what the sub-page does apart from its panels: the badge beside
// its title, and a session that runs while it is on screen. Delete what you do
// not need.

import (
	"example.com/yourapp/dashboard"
)

func myFeatureBadge(c *dashboard.Ctx) string {
	return c.Theme().Green.Render(c.Theme().G.Bullet + " OK")
}

// myFeatureSession starts work that only matters while the sub-page is on
// screen, and returns what stops it.
func myFeatureSession(c *dashboard.Ctx) func() {
	c.Flash("My Feature opened")
	return func() {}
}
